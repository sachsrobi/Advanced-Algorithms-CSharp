<Window x:Class="XV9E7B.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XV9E7B"
        Title="Coffee Machine" Height="500" Width="450" Background="Beige">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Top">
            <TextBlock Text="Coffee Machine" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

            <TextBlock Text="Coffee Amount (*200 Ft)" FontSize="14" Margin="0,10,0,5" />
            <StackPanel Orientation="Horizontal">
                <Slider Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CoffeeAmount, Mode=TwoWay}" Width="200" />
                <TextBlock Text="{Binding CoffeeAmount}" FontSize="14" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Text="Milk Amount (*100 Ft)" FontSize="14" Margin="0,10,0,5" />
            <StackPanel Orientation="Horizontal">
                <Slider Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding MilkAmount, Mode=TwoWay}" Width="200" />
                <TextBlock Text="{Binding MilkAmount}" FontSize="14" Margin="10,0,0,0" />
            </StackPanel>

            <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="5" Width="100" Background="LightGray" Padding="5" Margin="0,25,0,5">
                <TextBlock Text="{Binding Price, StringFormat='Price: {0} Ft'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <ProgressBar Minimum="0" Maximum="8" Orientation="Vertical" Height="150" Width="80" Background="LightGray" Margin="0,10,0,10"
                         Value="{Binding TotalAmount, Mode=OneWay}" 
                         Foreground="{Binding CoffeeColor}" />

            <Button Content="Add to Orders" Width="120" Height="30" Margin="0,10,0,0" Click="AddToOrders_Click" />
        </StackPanel>

        <!-- Right Panel -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Orders" FontSize="18" FontWeight="Bold" Margin="0,0,0,0" />
            <Border BorderThickness="2" BorderBrush="DarkGray" CornerRadius="5" Background="LightGray" Padding="10" Margin="0,10,0,10">
                <TextBlock Text="{Binding SumPrice, StringFormat='Total: {0} Ft'}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ListBox ItemsSource="{Binding Orders}" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="325">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="2" BorderBrush="Black" CornerRadius="5" Background="WhiteSmoke" Margin="0,5,0,5" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="20" Height="20" Fill="{Binding Color}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Price}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
